# Copia este archivo como .env y completa los valores reales.
# Nunca subas el archivo .env ni sus credenciales al repositorio.

# Base de datos SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=TecnoMovilDB
DB_USER=
DB_PASSWORD=

# Autenticación: usa una clave aleatoria de al menos 32 caracteres.
JWT_SECRET_KEY=

# Usuario administrador inicial. Completa ADMIN_IDENTIFICACION y ADMIN_PASSWORD
# antes del primer arranque; no uses una contraseña predeterminada.
ADMIN_NOMBRES=Administrador
ADMIN_CORREO=
ADMIN_IDENTIFICACION=
ADMIN_PASSWORD=

# Integración de IA
GEMINI_API_KEY=

# Servicio SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=TecnoMovil
